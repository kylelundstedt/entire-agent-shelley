#!/usr/bin/env python3
"""Entire external-agent adapter for Shelley conversation transcripts.

This first implementation is deliberately attach-only: it projects Shelley's
SQLite conversation record into a stable JSONL transcript that Entire can attach
to a Git commit. It does not install live Shelley hooks.
"""

from __future__ import annotations

import argparse
import base64
import hashlib
import json
import os
import re
import sqlite3
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, NoReturn

PROTOCOL_VERSION = 1
SESSION_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


def fail(message: str) -> NoReturn:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def emit(value: Any) -> None:
    json.dump(value, sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")


def db_path() -> Path:
    return Path(os.environ.get("SHELLEY_DB", "~/.config/shelley/shelley.db")).expanduser()


def cache_root() -> Path:
    configured = os.environ.get("ENTIRE_SHELLEY_CACHE")
    if configured:
        return Path(configured).expanduser()
    xdg = os.environ.get("XDG_CACHE_HOME")
    base = Path(xdg).expanduser() if xdg else Path("~/.cache").expanduser()
    return base / "entire-agent-shelley"


def connect() -> sqlite3.Connection:
    path = db_path()
    if not path.is_file():
        fail(f"Shelley database not found: {path}")
    uri = f"file:{path}?mode=ro"
    try:
        conn = sqlite3.connect(uri, uri=True)
    except sqlite3.Error as exc:
        fail(f"opening Shelley database: {exc}")
    conn.row_factory = sqlite3.Row
    return conn


def schema_present() -> bool:
    path = db_path()
    if not path.is_file():
        return False
    try:
        with connect() as conn:
            names = {
                row[0]
                for row in conn.execute(
                    "SELECT name FROM sqlite_master WHERE type='table' "
                    "AND name IN ('conversations','messages')"
                )
            }
            return names == {"conversations", "messages"}
    except SystemExit:
        return False
    except sqlite3.Error:
        return False


def validate_session_id(session_id: str) -> str:
    if not SESSION_ID_RE.fullmatch(session_id):
        fail(f"invalid Shelley conversation ID: {session_id!r}")
    return session_id


def canonical_repo(path: str | Path) -> Path:
    path = Path(path).expanduser().resolve()
    try:
        result = subprocess.run(
            ["git", "-C", str(path), "rev-parse", "--show-toplevel"],
            check=True,
            capture_output=True,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError) as exc:
        fail(f"not inside a Git worktree: {path}: {exc}")
    return Path(result.stdout.strip()).resolve()


def current_repo() -> Path | None:
    raw = os.environ.get("ENTIRE_REPO_ROOT")
    return canonical_repo(raw) if raw else None


def repo_cache_dir(repo: Path) -> Path:
    digest = hashlib.sha256(str(repo).encode()).hexdigest()[:16]
    return cache_root() / digest


def ensure_secure_dir(path: Path) -> Path:
    root = cache_root().expanduser().resolve()
    resolved = path.expanduser().resolve()
    try:
        resolved.relative_to(root)
    except ValueError:
        fail(f"Shelley adapter cache path is outside its root: {resolved}")
    for target in (root, resolved):
        target.mkdir(parents=True, exist_ok=True, mode=0o700)
        stat = target.stat()
        if stat.st_uid != os.getuid():
            fail(f"Shelley adapter cache is not owned by the current user: {target}")
        target.chmod(0o700)
    return resolved


def validate_session_dir(path: str | Path) -> Path:
    resolved = Path(path).expanduser().resolve()
    root = cache_root().resolve()
    try:
        resolved.relative_to(root)
    except ValueError:
        fail(f"session directory is outside the Shelley adapter cache: {resolved}")
    repo = current_repo()
    if repo is not None and resolved != repo_cache_dir(repo).resolve():
        fail(f"session directory does not match the current repository: {resolved}")
    return resolved


def parse_json(raw: str | None, fallback: Any) -> Any:
    if not raw:
        return fallback
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return fallback


def iso8601(raw: str | None) -> str:
    if not raw:
        return ""
    value = raw.replace(" ", "T", 1)
    if value.endswith("Z") or re.search(r"[+-]\d\d:\d\d$", value):
        return value
    try:
        parsed = datetime.fromisoformat(value).replace(tzinfo=timezone.utc)
        return parsed.isoformat().replace("+00:00", "Z")
    except ValueError:
        return value + "Z"


def conversation(conn: sqlite3.Connection, session_id: str) -> sqlite3.Row:
    row = conn.execute(
        "SELECT conversation_id, slug, cwd, model, parent_conversation_id, "
        "created_at, updated_at FROM conversations WHERE conversation_id = ?",
        (session_id,),
    ).fetchone()
    if row is None:
        fail(f"Shelley conversation not found: {session_id}")
    if row["parent_conversation_id"] and os.environ.get("ENTIRE_SHELLEY_ALLOW_SUBAGENT") != "1":
        fail(
            f"Shelley conversation {session_id} is a subagent; "
            "set ENTIRE_SHELLEY_ALLOW_SUBAGENT=1 to attach it explicitly"
        )
    return row


def ensure_repo_match(row: sqlite3.Row, expected_repo: Path | None) -> Path:
    cwd = row["cwd"]
    if not cwd:
        fail(f"Shelley conversation {row['conversation_id']} has no cwd")
    repo = canonical_repo(cwd)
    if expected_repo is not None and repo != expected_repo:
        fail(
            f"conversation belongs to {repo}, not current repository {expected_repo}"
        )
    return repo


def content_parts(data: dict[str, Any]) -> list[dict[str, Any]]:
    content = data.get("Content")
    return content if isinstance(content, list) else []


def tool_input(part: dict[str, Any]) -> Any:
    value = part.get("ToolInput")
    if value is None:
        return {}
    if isinstance(value, str):
        return parse_json(value, {"raw": value})
    return value


def tool_result_text(part: dict[str, Any]) -> str:
    results = part.get("ToolResult")
    if not isinstance(results, list) or not results:
        return ""
    if os.environ.get("ENTIRE_SHELLEY_INCLUDE_TOOL_RESULTS") != "1":
        return "[tool result omitted by Shelley adapter data-minimization policy]"
    texts: list[str] = []
    for result in results:
        if not isinstance(result, dict):
            continue
        text = result.get("Text")
        if isinstance(text, str) and text:
            texts.append(text)
    return "\n".join(texts)


def projected_content(message_type: str, data: dict[str, Any]) -> list[dict[str, Any]]:
    projected: list[dict[str, Any]] = []
    for part in content_parts(data):
        if not isinstance(part, dict):
            continue
        kind = part.get("Type")
        allowed = {"user": {2, 6}, "agent": {2, 3, 5, 7}}[message_type]
        if kind not in allowed:
            fail(f"unsupported Shelley content type {kind!r} in {message_type} message")
        if message_type == "user":
            if kind == 2 and isinstance(part.get("Text"), str) and part["Text"]:
                projected.append({"type": "text", "text": part["Text"]})
            elif kind == 6:
                result = tool_result_text(part)
                if result:
                    projected.append(
                        {
                            "type": "tool_result",
                            "tool_use_id": part.get("ToolUseID") or part.get("ID") or "",
                            "content": result,
                            "is_error": bool(part.get("ToolError")),
                        }
                    )
        elif message_type == "agent":
            if kind == 2 and isinstance(part.get("Text"), str) and part["Text"]:
                projected.append({"type": "text", "text": part["Text"]})
            elif kind in (5, 7) and part.get("ToolName"):
                projected.append(
                    {
                        "type": "tool_use",
                        "id": part.get("ID") or part.get("ToolUseID") or "",
                        "name": part["ToolName"],
                        "input": tool_input(part),
                    }
                )
            # Shelley Type 3 is model reasoning. It is intentionally excluded.
    return projected


def table_columns(conn: sqlite3.Connection, table: str) -> set[str]:
    return {str(row[1]) for row in conn.execute(f"PRAGMA table_info({table})")}


def iter_messages(
    conn: sqlite3.Connection, session_id: str
) -> list[sqlite3.Row]:
    excluded_filter = " AND excluded_from_context = 0" if "excluded_from_context" in table_columns(conn, "messages") else ""
    return conn.execute(
        "SELECT message_id, sequence_id, type, llm_data, created_at, model_name "
        "FROM messages WHERE conversation_id = ? "
        "AND type IN ('user','agent')" + excluded_filter + " ORDER BY sequence_id",
        (session_id,),
    ).fetchall()


def project_transcript(
    conn: sqlite3.Connection, session_id: str
) -> tuple[bytes, list[str]]:
    lines: list[bytes] = []
    touched: set[str] = set()
    for row in iter_messages(conn, session_id):
        try:
            data = json.loads(row["llm_data"] or "")
        except json.JSONDecodeError as exc:
            fail(
                f"invalid llm_data in Shelley message {row['message_id']}: {exc}"
            )
        if not isinstance(data, dict):
            fail(f"non-object llm_data in Shelley message {row['message_id']}")
        parts = projected_content(row["type"], data)
        if not parts:
            continue
        role = "assistant" if row["type"] == "agent" else "user"
        message: dict[str, Any] = {"role": role, "content": parts}
        if role == "assistant" and row["model_name"]:
            message["model"] = row["model_name"]
        line = {
            "type": role,
            "uuid": row["message_id"],
            "timestamp": iso8601(row["created_at"]),
            "message": message,
            "shelley": {"sequence_id": row["sequence_id"]},
        }
        lines.append(json.dumps(line, separators=(",", ":")).encode() + b"\n")
        touched.update(extract_paths(parts))
    if not lines:
        fail(f"Shelley conversation has no projectable messages: {session_id}")
    return b"".join(lines), sorted(touched)


def extract_paths(parts: list[dict[str, Any]]) -> set[str]:
    repo = current_repo()
    if repo is None:
        return set()
    found: set[str] = set()
    for part in parts:
        if part.get("type") != "tool_use":
            continue
        value = part.get("input")
        if not isinstance(value, dict):
            continue
        for key in ("path", "file_path", "notebook_path"):
            raw = value.get(key)
            if not isinstance(raw, str) or not raw:
                continue
            candidate = Path(raw)
            if not candidate.is_absolute():
                candidate = repo / candidate
            try:
                relative = candidate.resolve().relative_to(repo)
            except ValueError:
                continue
            found.add(relative.as_posix())
    return found


def atomic_write(path: Path, data: bytes, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.parent.chmod(0o700)
    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_name, path)
    finally:
        try:
            os.unlink(temp_name)
        except FileNotFoundError:
            pass


def materialize(session_id: str, session_dir: Path) -> tuple[Path, dict[str, Any]]:
    validate_session_id(session_id)
    expected = current_repo()
    with connect() as conn:
        row = conversation(conn, session_id)
        repo = ensure_repo_match(row, expected)
        transcript, touched = project_transcript(conn, session_id)
        path = session_dir / f"{session_id}.jsonl"
        metadata = {
            "session_id": session_id,
            "agent_name": "shelley",
            "repo_path": str(repo),
            "session_ref": str(path),
            "start_time": iso8601(row["created_at"]),
            "modified_files": touched,
            "new_files": [],
            "deleted_files": [],
            "conversation": {
                "slug": row["slug"],
                "model": row["model"],
                "parent_conversation_id": row["parent_conversation_id"],
                "updated_at": iso8601(row["updated_at"]),
            },
        }
    atomic_write(path, transcript)
    atomic_write(
        path.with_suffix(".session.json"),
        (json.dumps(metadata, indent=2) + "\n").encode(),
    )
    return path, metadata


def arg_value(args: list[str], name: str) -> str:
    try:
        index = args.index(name)
        return args[index + 1]
    except (ValueError, IndexError):
        fail(f"missing required argument {name}")


def stdin_json() -> dict[str, Any]:
    raw = sys.stdin.buffer.read()
    if not raw.strip():
        return {}
    try:
        value = json.loads(raw)
    except json.JSONDecodeError as exc:
        fail(f"invalid JSON on stdin: {exc}")
    return value if isinstance(value, dict) else {}


def command_info() -> None:
    emit(
        {
            "protocol_version": PROTOCOL_VERSION,
            "name": "shelley",
            "type": "Shelley",
            "description": "Shelley conversation adapter (attach-only preview)",
            "is_preview": True,
            "protected_dirs": [],
            "protected_files": [],
            "hook_names": [],
            "capabilities": {
                "hooks": False,
                "transcript_analyzer": False,
                "transcript_preparer": False,
                "token_calculator": False,
                "text_generator": False,
                "hook_response_writer": False,
                "subagent_aware_extractor": False,
            },
        }
    )


def command_detect() -> None:
    emit({"present": schema_present()})


def command_get_session_id() -> None:
    value = stdin_json()
    raw = value.get("session_id")
    if not raw and isinstance(value.get("raw_data"), dict):
        raw = value["raw_data"].get("conversation_id")
    emit({"session_id": validate_session_id(str(raw or ""))})


def command_get_session_dir(args: list[str]) -> None:
    repo = canonical_repo(arg_value(args, "--repo-path"))
    path = ensure_secure_dir(repo_cache_dir(repo))
    emit({"session_dir": str(path)})


def command_resolve_session_file(args: list[str]) -> None:
    session_dir = validate_session_dir(arg_value(args, "--session-dir"))
    session_id = validate_session_id(arg_value(args, "--session-id"))
    path, _ = materialize(session_id, session_dir)
    emit({"session_file": str(path)})


def command_read_session() -> None:
    value = stdin_json()
    session_id = validate_session_id(str(value.get("session_id") or ""))
    repo = current_repo()
    if repo is None:
        fail("ENTIRE_REPO_ROOT is required for read-session")
    _, metadata = materialize(session_id, ensure_secure_dir(repo_cache_dir(repo)))
    native = json.dumps(metadata.pop("conversation"), separators=(",", ":")).encode()
    metadata["native_data"] = base64.b64encode(native).decode()
    emit(metadata)


def command_write_session() -> None:
    _ = stdin_json()
    fail(
        "write-session is unsupported by the attach-only Shelley adapter; "
        "rewind/resume restoration is not implemented"
    )


def validate_transcript_path(raw: str) -> Path:
    repo = current_repo()
    if repo is None:
        fail("ENTIRE_REPO_ROOT is required for read-transcript")
    path = Path(raw).expanduser().resolve()
    expected_dir = repo_cache_dir(repo).resolve()
    if path.parent != expected_dir or path.suffix != ".jsonl":
        fail(f"session transcript does not belong to the current repository: {path}")
    session_id = validate_session_id(path.stem)
    sidecar = path.with_suffix(".session.json")
    try:
        metadata = json.loads(sidecar.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"reading Shelley session metadata: {exc}")
    if (
        metadata.get("session_id") != session_id
        or Path(metadata.get("repo_path", "")).resolve() != repo
        or Path(metadata.get("session_ref", "")).resolve() != path
    ):
        fail(f"Shelley session metadata does not match transcript: {path}")
    return path


def command_read_transcript(args: list[str]) -> None:
    path = validate_transcript_path(arg_value(args, "--session-ref"))
    try:
        sys.stdout.buffer.write(path.read_bytes())
    except OSError as exc:
        fail(f"reading transcript: {exc}")


def command_chunk_transcript(args: list[str]) -> None:
    try:
        maximum = int(arg_value(args, "--max-size"))
    except ValueError:
        fail("--max-size must be an integer")
    if maximum <= 0:
        fail("--max-size must be positive")
    raw = sys.stdin.buffer.read()
    chunks = [
        base64.b64encode(raw[index : index + maximum]).decode()
        for index in range(0, len(raw), maximum)
    ]
    emit({"chunks": chunks})


def command_reassemble_transcript() -> None:
    value = stdin_json()
    chunks = value.get("chunks")
    if not isinstance(chunks, list):
        fail("chunks must be an array")
    try:
        raw = b"".join(base64.b64decode(chunk, validate=True) for chunk in chunks)
    except (TypeError, ValueError) as exc:
        fail(f"invalid base64 chunk: {exc}")
    sys.stdout.buffer.write(raw)


def command_format_resume(args: list[str]) -> None:
    session_id = validate_session_id(arg_value(args, "--session-id"))
    emit({"command": f"shelley client chat -c {session_id}"})


def main() -> None:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("command", nargs="?")
    parsed, rest = parser.parse_known_args()
    command = parsed.command
    if command == "info":
        command_info()
    elif command == "detect":
        command_detect()
    elif command == "get-session-id":
        command_get_session_id()
    elif command == "get-session-dir":
        command_get_session_dir(rest)
    elif command == "resolve-session-file":
        command_resolve_session_file(rest)
    elif command == "read-session":
        command_read_session()
    elif command == "write-session":
        command_write_session()
    elif command == "read-transcript":
        command_read_transcript(rest)
    elif command == "chunk-transcript":
        command_chunk_transcript(rest)
    elif command == "reassemble-transcript":
        command_reassemble_transcript()
    elif command == "format-resume-command":
        command_format_resume(rest)
    else:
        fail(f"unsupported subcommand: {command or '<none>'}")


if __name__ == "__main__":
    main()
