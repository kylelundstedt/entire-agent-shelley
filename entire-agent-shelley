#!/bin/sh
# Compatibility alias for checkpoints created by the original Shelley-specific
# prototype. New cross-agent use should call entire-agent-agentsview directly.
set -eu
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export ENTIRE_AGENTSVIEW_ADAPTER_NAME=shelley
export ENTIRE_AGENTSVIEW_ADAPTER_TYPE=Shelley
export ENTIRE_AGENTSVIEW_AGENT_FILTER=shelley
exec "$DIR/entire-agent-agentsview" "$@"
