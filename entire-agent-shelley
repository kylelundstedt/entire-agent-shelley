def command_get_session_id() -> None:
    value = stdin_json()
    raw = value.get("session_id")
    if not raw and isinstance(value.get("raw_data"), dict):
        raw = value["raw_data"].get("conversation_id")
    emit({"session_id": validate_session_id(str(raw or ""))})


def command_get_session_dir(args: list[str]) -> None:
    repo = canonical_repo(arg_value(args, "--repo-path"))
    path = ensure_secure_dir(repo_cache_dir(repo))
    emit({"session_dir": str(path)})


def command_resolve_session_file(args: list[str]) -> None:
    session_dir = validate_session_dir(arg_value(args, "--session-dir"))
    session_id = validate_session_id(arg_value(args, "--session-id"))
    path, _ = materialize(session_id, session_dir)
    emit({"session_file": str(path)})


def command_read_session() -> None:
    value = stdin_json()
    session_id = validate_session_id(str(value.get("session_id") or ""))
    repo = current_repo()
    if repo is None:
        fail("ENTIRE_REPO_ROOT is required for read-session")
    _, metadata = materialize(session_id, ensure_secure_dir(repo_cache_dir(repo)))
    native = json.dumps(metadata.pop("conversation"), separators=(",", ":")).encode()
    metadata["native_data"] = base64.b64encode(native).decode()
    emit(metadata)


def command_write_session() -> None:
    _ = stdin_json()
    fail(
        "write-session is unsupported by the Shelley live plugin; "
        "rewind/resume restoration is not implemented"
    )


def validate_transcript_path(raw: str) -> Path:
    repo = current_repo()
    if repo is None:
        fail("ENTIRE_REPO_ROOT is required for read-transcript")
    path = Path(raw).expanduser().resolve()
    expected_dir = repo_cache_dir(repo).resolve()
    if path.parent != expected_dir or path.suffix != ".jsonl":
        fail(f"session transcript does not belong to the current repository: {path}")
    session_id = validate_session_id(path.stem)
    sidecar = path.with_suffix(".session.json")
    try:
        metadata = json.loads(sidecar.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"reading Shelley session metadata: {exc}")
    if (
        metadata.get("session_id") != session_id
        or Path(metadata.get("repo_path", "")).resolve() != repo
        or Path(metadata.get("session_ref", "")).resolve() != path
    ):
        fail(f"Shelley session metadata does not match transcript: {path}")
    return path


def command_read_transcript(args: list[str]) -> None:
    path = validate_transcript_path(arg_value(args, "--session-ref"))
    try:
        sys.stdout.buffer.write(path.read_bytes())
    except OSError as exc:
        fail(f"reading transcript: {exc}")


def command_chunk_transcript(args: list[str]) -> None:
    try:
        maximum = int(arg_value(args, "--max-size"))
    except ValueError:
        fail("--max-size must be an integer")
    if maximum <= 0:
        fail("--max-size must be positive")
    raw = sys.stdin.buffer.read()
    chunks = [
        base64.b64encode(raw[index : index + maximum]).decode()
        for index in range(0, len(raw), maximum)
    ]
    emit({"chunks": chunks})


def command_reassemble_transcript() -> None:
    value = stdin_json()
    chunks = value.get("chunks")
    if not isinstance(chunks, list):
        fail("chunks must be an array")
    try:
        raw = b"".join(base64.b64decode(chunk, validate=True) for chunk in chunks)
    except (TypeError, ValueError) as exc:
        fail(f"invalid base64 chunk: {exc}")
    sys.stdout.buffer.write(raw)


def command_format_resume(args: list[str]) -> None:
    session_id = validate_session_id(arg_value(args, "--session-id"))
    emit({"command": f"shelley client chat -c {session_id} -p '<continue>'"})


def main() -> None:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("command", nargs="?")
    parsed, rest = parser.parse_known_args()
    command = parsed.command
    if command == "version":
        command_version()
    elif command == "info":
        command_info()
    elif command == "detect":
        command_detect()
    elif command == "get-session-id":
        command_get_session_id()
    elif command == "get-session-dir":
        command_get_session_dir(rest)
    elif command == "resolve-session-file":
        command_resolve_session_file(rest)
    elif command == "read-session":
        command_read_session()
    elif command == "write-session":
        command_write_session()
    elif command == "read-transcript":
        command_read_transcript(rest)
    elif command == "chunk-transcript":
        command_chunk_transcript(rest)
    elif command == "reassemble-transcript":
        command_reassemble_transcript()
    elif command == "format-resume-command":
        command_format_resume(rest)
    elif command == "parse-hook":
        command_parse_hook(rest)
    elif command == "install-hooks":
        command_install_hooks(rest)
    elif command == "uninstall-hooks":
        command_uninstall_hooks()
    elif command == "are-hooks-installed":
        command_are_hooks_installed()
    elif command == "run-hook":
        command_run_hook(rest)
    else:
        fail(f"unsupported subcommand: {command or '<none>'}")


if __name__ == "__main__":
    main()
